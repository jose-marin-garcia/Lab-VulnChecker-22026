// Pipeline DevSecOps (Soporta desactivar Quality Gates estrictos)
pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'vulnchecker'
        DOCKER_NETWORK       = 'vulnchecker_devsecops'
        APP_BACKEND_URL      = 'http://backend:8080'
        APP_FRONTEND_URL     = 'http://frontend:5173'
        SONAR_HOST           = 'http://sonarqube:9000'
        BACKEND_IMAGE        = 'vulnchecker-backend'
        FRONTEND_IMAGE       = 'vulnchecker-frontend'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        choice(name: 'STRICT_GATES', choices: ['true', 'false'], description: 'true: Bloquea el despliegue ante fallos/vulnerabilidades. false: Ignora fallos en gates de seguridad.')
        choice(name: 'SKIP_SONAR', choices: ['false', 'true'], description: 'Omitir análisis SAST con SonarQube')
        string(name: 'SONAR_SERVER_NAME', defaultValue: 'SonarQube', description: "Nombre exacto de la instalación SonarQube en Jenkins")
        choice(name: 'SKIP_CHECKOUT', choices: ['false', 'true'], description: "true solo si el workspace ya tiene el repo")
        choice(name: 'SKIP_JUNIT', choices: ['false', 'true'], description: 'Omitir pruebas unitarias (JUnit)')
        choice(name: 'SKIP_DEPENDENCY_CHECK', choices: ['false', 'true'], description: 'Omitir OWASP Dependency Check')
        choice(name: 'SKIP_ZAP', choices: ['false', 'true'], description: 'Omitir DAST (OWASP ZAP)')
        password(name: 'NVD_API_KEY', description: 'API key de NVD para evitar rate limit 429')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    if (params.SKIP_CHECKOUT == 'true') {
                        if (!fileExists('vulncheckerbackend/pom.xml')) {
                            error('SKIP_CHECKOUT=true pero no hay código en el workspace.')
                        }
                        echo 'Checkout omitido; usando código existente.'
                    } else {
                        checkout scm
                    }
                }
            }
        }

        stage('Prepare reports dirs') {
            steps {
                sh """
                    mkdir -p /jenkins-reports/latest/dependency-check-backend \
                             /jenkins-reports/latest/dependency-check-frontend \
                             /jenkins-reports/latest/trivy \
                             /jenkins-reports/latest/zap \
                             reports/zap reports/trivy \
                             reports/dependency-check-backend \
                             reports/dependency-check-frontend
                    chmod -R 777 /jenkins-reports/latest reports 2>/dev/null || true
                    chmod +x vulncheckerbackend/mvnw 2>/dev/null || true
                """
            }
        }

        // FASE 1: Verificaciones Rápidas y Pruebas Unitarias
        stage('Fase 1: Pruebas Iniciales y Análisis de Secretos') {
            parallel {
                stage('Secret Scanning (Gitleaks)') {
                    steps {
                        script {
                            // Si STRICT_GATES es false, añadimos || true para evitar que rompa la ejecución
                            def ignoreError = (params.STRICT_GATES == 'false') ? '|| true' : ''
                            sh """
                                docker run --rm \
                                    -v "\${WORKSPACE}:/repo:rw" \
                                    ghcr.io/zricethezav/gitleaks:latest \
                                    detect --source /repo --no-git --verbose \
                                    --report-path /repo/reports/gitleaks-report.json ${ignoreError}
                            """
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }

                stage('Unit Tests (Backend)') {
                    when { expression { return params.SKIP_JUNIT != 'true' } }
                    steps {
                        dir('vulncheckerbackend') {
                            sh './mvnw test -q'
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'vulncheckerbackend/target/surefire-reports/*.xml'
                        }
                    }
                }
            }
        }

        // FASE 2: Análisis de Código y Construcción de Contenedores
        stage('Fase 2: Análisis de Seguridad y Empaquetado') {
            parallel {
                stage('Code Security (SCA & SAST)') {
                    stages {
                        stage('OWASP Dependency Check') {
                            when { expression { return params.SKIP_DEPENDENCY_CHECK != 'true' } }
                            steps {
                                dir('vulncheckerbackend') {
                                    sh './mvnw dependency:copy-dependencies -DoutputDirectory=target/dependency -q'
                                }
                                script {
                                    def nvdKey = (params.NVD_API_KEY != null && params.NVD_API_KEY != '') ? params.NVD_API_KEY : ''
                                    // Si STRICT_GATES=false, usamos failOnCVSS 11 para impedir que rompa por vulnerabilidades
                                    def cvssFailScore = (params.STRICT_GATES == 'true') ? '7' : '11'
                                    
                                    withEnv(["NVD_API_KEY=${nvdKey}"]) {
                                        dir('vulncheckerbackend') {
                                            sh """
                                                docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \
                                                    -e NVD_API_KEY=\$NVD_API_KEY \
                                                    -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw \
                                                    owasp/dependency-check:latest \
                                                    --scan \${WORKSPACE}/vulncheckerbackend \
                                                    --format HTML --format JSON \
                                                    --out /jenkins-reports/latest/dependency-check-backend \
                                                    --project vulnchecker-backend \
                                                    --failOnCVSS ${cvssFailScore} \${NVD_API_KEY:+--nvdApiKey \$NVD_API_KEY}
                                            """
                                        }
                                        dir('frontend') {
                                            sh """
                                                docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \
                                                    -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw \
                                                    owasp/dependency-check:latest \
                                                    --scan \${WORKSPACE}/frontend --noupdate \
                                                    --format HTML --format JSON \
                                                    --out /jenkins-reports/latest/dependency-check-frontend \
                                                    --project vulnchecker-frontend \
                                                    --failOnCVSS ${cvssFailScore}
                                            """
                                        }
                                    }
                                }
                            }
                            post {
                                always {
                                    sh """
                                        cp -r /jenkins-reports/latest/dependency-check-backend \${WORKSPACE}/reports/ 2>/dev/null || true
                                        cp -r /jenkins-reports/latest/dependency-check-frontend \${WORKSPACE}/reports/ 2>/dev/null || true
                                    """
                                    archiveArtifacts artifacts: 'reports/**/dependency-check-report.html', allowEmptyArchive: true
                                }
                            }
                        }

                        stage('SonarQube Analysis & Quality Gate') {
                            when { expression { return params.SKIP_SONAR != 'true' } }
                            steps {
                                withSonarQubeEnv(params.SONAR_SERVER_NAME?.trim() ?: 'SonarQube') {
                                    dir('vulncheckerbackend') {
                                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                                            sh """
                                                ./mvnw compile -DskipTests -q
                                                ./mvnw sonar:sonar -q \
                                                    -Dsonar.host.url=\${SONAR_HOST_URL:-\${SONAR_HOST}} \
                                                    -Dsonar.token=\${SONAR_TOKEN} \
                                                    -Dsonar.projectKey=vulnchecker-backend \
                                                    -Dsonar.projectName=vulnchecker-backend \
                                                    -Dsonar.java.binaries=target/classes
                                            """
                                        }
                                    }
                                }
                                timeout(time: 5, unit: 'MINUTES') {
                                    script {
                                        def qg = waitForQualityGate()
                                        // Evaluamos Quality Gate solo si STRICT_GATES está activado
                                        if (params.STRICT_GATES == 'true' && qg.status != 'OK') {
                                            error "SonarQube Quality Gate no superado. Estado: ${qg.status}"
                                        } else if (qg.status != 'OK') {
                                            echo "ADVERTENCIA: SonarQube Quality Gate falló (${qg.status}), pero STRICT_GATES está desactivado."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                stage('Containerization (Docker & Trivy)') {
                    stages {
                        stage('Build Docker Images') {
                            steps {
                                sh 'docker compose -f docker-compose.yml -f docker-compose.ci.yml build backend frontend'
                            }
                        }

                        stage('Container Image Scan (Trivy)') {
                            steps {
                                script {
                                    // exit-code 1 rompe el build, exit-code 0 permite continuar aunque encuentre fallos
                                    def exitCode = (params.STRICT_GATES == 'true') ? '1' : '0'
                                    sh """
                                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                                            aquasec/trivy:latest image --severity HIGH,CRITICAL \
                                            --ignore-unfixed --exit-code ${exitCode} --format table \${BACKEND_IMAGE}

                                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                                            aquasec/trivy:latest image --severity HIGH,CRITICAL \
                                            --ignore-unfixed --exit-code ${exitCode} --format table \${FRONTEND_IMAGE}
                                    """
                                }
                            }
                            post {
                                always {
                                    sh """
                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \
                                            -v /var/run/docker.sock:/var/run/docker.sock \
                                            aquasec/trivy:latest image --format json \
                                            --output /jenkins-reports/latest/trivy/trivy-backend.json \${BACKEND_IMAGE} || true

                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \
                                            -v /var/run/docker.sock:/var/run/docker.sock \
                                            aquasec/trivy:latest image --format json \
                                            --output /jenkins-reports/latest/trivy/trivy-frontend.json \${FRONTEND_IMAGE} || true

                                        cp -r /jenkins-reports/latest/trivy/*.json \${WORKSPACE}/reports/trivy/ 2>/dev/null || true
                                    """
                                    archiveArtifacts artifacts: 'reports/trivy/*.json', allowEmptyArchive: true
                                }
                            }
                        }
                    }
                }
            }
        }

        // FASE 3: Despliegue de la Nueva Versión
        stage('Fase 3: Desplegar / Actualizar Servicios') {
            steps {
                echo "Desplegando servicios con las imágenes de producción..."
                sh 'docker compose -f docker-compose.yml -f docker-compose.ci.yml up -d db backend frontend'
            }
        }

        // FASE 4: Análisis Dinámico (DAST) sobre la app desplegada
        stage('Fase 4: DAST - OWASP ZAP') {
            when { expression { return params.SKIP_ZAP != 'true' } }
            steps {
                sh '''
                    echo "Esperando que el backend recién desplegado responda en el puerto 8080..."
                    for i in $(seq 1 30); do
                        if curl -sf http://backend:8080/actuator/health >/dev/null 2>&1 || curl -sf http://backend:8080 >/dev/null 2>&1; then
                            echo "Backend listo y actualizado."
                            break
                        fi
                        echo "Esperando backend... ($i/30)"
                        sleep 5
                    done
                '''
                script {
                    timeout(time: 15, unit: 'MINUTES') {
                        // Si STRICT_GATES es false, añadimos la flag -a a ZAP para ignorar advertencias/errores como fallos
                        def zapExtraFlags = (params.STRICT_GATES == 'false') ? '-a' : ''
                        sh """
                            docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \
                                --network \${DOCKER_NETWORK} \
                                --entrypoint bash \
                                ghcr.io/zaproxy/zaproxy:latest \
                                -c "rm -rf /zap/wrk && ln -s /jenkins-reports/latest/zap /zap/wrk && exec zap-baseline.py -t http://backend:8080 -r zap-report.html -J zap-report.json -I -s -m 3 ${zapExtraFlags}"

                            cp /jenkins-reports/latest/zap/zap-report.* \${WORKSPACE}/reports/zap/ 2>/dev/null || true
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/zap/*.html, reports/zap/*.json', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            sh """
                if [ -d "\${WORKSPACE}/reports" ] && [ "\$(ls -A \${WORKSPACE}/reports 2>/dev/null)" ]; then
                    cp -rv \${WORKSPACE}/reports/* /jenkins-reports/latest/ || echo "Warning: no se pudo copiar reports"
                fi
            """
        }
        success {
            echo 'Pipeline DevSecOps completado exitosamente.'
        }
        failure {
            echo 'CRÍTICO: El Pipeline falló debido a vulnerabilidades encontradas o errores de código. Revisa los artefactos y logs.'
        }
    }
}