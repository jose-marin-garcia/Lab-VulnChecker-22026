// Pipeline DevSecOps Paralelizado con Despliegue: Secretos, Build, Test, SAST, SCA, escaneo de imágenes, Deploy y DAST (ZAP)
pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'vulnchecker'
        DOCKER_NETWORK = 'vulnchecker_devsecops'
        APP_BACKEND_URL = 'http://backend:8080'
        APP_FRONTEND_URL = 'http://frontend:5173'
        SONAR_HOST = 'http://sonarqube:9000'
        BACKEND_IMAGE = 'vulnchecker-backend'
        FRONTEND_IMAGE = 'vulnchecker-frontend'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        booleanParam(name: 'ENABLE_SECURITY_GATES', defaultValue: false, description: 'Si es true, el pipeline FALLA si se detectan secretos o vulnerabilidades críticas/altas')
        booleanParam(name: 'SKIP_SONAR', defaultValue: false, description: 'Si eliges true se omite el análisis SAST con SonarQube')
        string(name: 'SONAR_SERVER_NAME', defaultValue: 'SonarQube', description: "Nombre exacto de la instalación SonarQube en Jenkins")
        booleanParam(name: 'SKIP_CHECKOUT', defaultValue: false, description: "Usar true solo si el job NO es 'Pipeline from SCM'")
        booleanParam(name: 'SKIP_JUNIT', defaultValue: false, description: 'Si eliges true se omite el stage Unit Tests (JUnit)')
        booleanParam(name: 'SKIP_DEPENDENCY_CHECK', defaultValue: false, description: 'true = omitir OWASP Dependency Check')
        booleanParam(name: 'SKIP_TRIVY', defaultValue: false, description: 'true = omitir escaneo de imágenes con Trivy')
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: 'true = omitir etapa de despliegue (Deploy)')
        booleanParam(name: 'SKIP_ZAP', defaultValue: false, description: 'true = omitir DAST (OWASP ZAP).')
        password(name: 'NVD_API_KEY', description: 'Opcional. API key de NVD (nvd.nist.gov → Request API Key) para evitar rate limit 429.')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    if (params.SKIP_CHECKOUT) {
                        if (!fileExists('vulncheckerbackend/pom.xml')) {
                            error('SKIP_CHECKOUT=true pero no hay código en el workspace. Configura el job como "Pipeline script from SCM" (Git + Script Path: Jenkinsfile3) o clona el repo antes de ejecutar.')
                        }
                        echo 'Checkout omitido; usando código existente en el workspace.'
                    } else {
                        try {
                            checkout scm
                        } catch (Exception e) {
                            error("Checkout falló: Original: ${e.message}")
                        }
                    }
                }
            }
        }

        stage('Prepare reports dirs') {
            steps {
                sh """
                    mkdir -p /jenkins-reports/latest
                    mkdir -p /jenkins-reports/latest/dependency-check-backend /jenkins-reports/latest/dependency-check-frontend /jenkins-reports/latest/trivy /jenkins-reports/latest/zap
                    chmod -R 777 /jenkins-reports/latest 2>/dev/null || true
                    mkdir -p reports reports/zap reports/trivy reports/dependency-check-backend reports/dependency-check-frontend
                    chmod -R 777 reports 2>/dev/null || true
                    chmod +x vulncheckerbackend/mvnw 2>/dev/null || true
                """
            }
        }

        stage('Fase 1: Preparaciones y Builds Paralelos') {
            parallel {
                stage('Secret Scanning (Gitleaks)') {
                    steps {
                        sh """
                            mkdir -p reports
                            rm -f reports/gitleaks-report.json
                            chmod -R 777 reports 2>/dev/null || true

                            docker run --rm \\
                                -v "\${WORKSPACE}:/repo:rw" \\
                                ghcr.io/zricethezav/gitleaks:latest \\
                                detect --source /repo --no-git --verbose \\
                                --report-path /repo/reports/gitleaks-report.json \\
                                || true

                            chmod 777 reports/gitleaks-report.json 2>/dev/null || true

                            if [ ! -s reports/gitleaks-report.json ]; then
                                echo '{"version":"0","results":[],"message":"No secrets detected (or report not generated)"}' > reports/gitleaks-report.json
                            fi
                        """
                        script {
                            if (params.ENABLE_SECURITY_GATES) {
                                def report = readFile('reports/gitleaks-report.json').trim()
                                if (report != '' && !report.contains('"results":[]') && report.contains('"Match":')) {
                                    error("[SECURITY GATE FAIL] Gitleaks detectó secretos en el código fuente.")
                                }
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }

                stage('Backend Build & Test') {
                    stages {
                        stage('Build Backend') {
                            steps {
                                dir('vulncheckerbackend') {
                                    sh 'chmod +x mvnw && ./mvnw clean compile -q -DskipTests'
                                }
                            }
                        }
                        stage('Unit Tests') {
                            when { expression { return !params.SKIP_JUNIT } }
                            steps {
                                dir('vulncheckerbackend') {
                                    sh 'chmod +x mvnw && ./mvnw clean test jacoco:report -q'
                                }
                            }
                            post {
                                always {
                                    junit allowEmptyResults: true, testResults: 'vulncheckerbackend/target/surefire-reports/*.xml'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Fase 2: Análisis de Seguridad y Contenedores') {
            parallel {
                stage('Code Security (SCA & SAST)') {
                    stages {
                        stage('OWASP Dependency Check') {
                            when { expression { return !params.SKIP_DEPENDENCY_CHECK } }
                            steps {
                                dir('vulncheckerbackend') {
                                    sh 'chmod +x mvnw && ./mvnw dependency:copy-dependencies -DoutputDirectory=target/dependency -q'
                                }
                                script {
                                    echo 'OWASP Dependency Check: backend descarga NVD.'
                                    timeout(time: 90, unit: 'MINUTES') {
                                        def nvdKey = (params.NVD_API_KEY != null && params.NVD_API_KEY != '') ? params.NVD_API_KEY : ''
                                        if (nvdKey == '' && fileExists('.env')) {
                                            readFile('.env').split('\n').each { line ->
                                                def t = line.trim()
                                                if (t.startsWith('NVD_API_KEY=')) {
                                                    nvdKey = t.substring(12).trim()
                                                    if (nvdKey.size() >= 2 && ((nvdKey.startsWith('"') && nvdKey.endsWith('"')) || (nvdKey.startsWith("'") && nvdKey.endsWith("'")))) {
                                                        nvdKey = nvdKey[1..-2]
                                                    }
                                                }
                                            }
                                        }
                                        def failCvss = params.ENABLE_SECURITY_GATES ? "7" : "11"
                                        if (nvdKey != '') {
                                            withEnv(["NVD_API_KEY=${nvdKey}"]) {
                                                dir('vulncheckerbackend') {
                                                    sh """
                                                        echo ">>> Dependency Check (backend)"
                                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) -e NVD_API_KEY=\$NVD_API_KEY -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw owasp/dependency-check:latest --scan \${WORKSPACE}/vulncheckerbackend --format HTML --format JSON --out /jenkins-reports/latest/dependency-check-backend --project vulnchecker-backend --failOnCVSS ${failCvss} \${NVD_API_KEY:+--nvdApiKey \$NVD_API_KEY} || true
                                                    """
                                                }
                                                dir('frontend') {
                                                    sh """
                                                        echo ">>> Dependency Check (frontend)"
                                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw owasp/dependency-check:latest --scan \${WORKSPACE}/frontend --noupdate --format HTML --format JSON --out /jenkins-reports/latest/dependency-check-frontend --project vulnchecker-frontend --failOnCVSS ${failCvss} || true
                                                    """
                                                }
                                            }
                                        } else {
                                            withEnv(['NVD_API_KEY=']) {
                                                dir('vulncheckerbackend') {
                                                    sh """
                                                        echo ">>> Dependency Check (backend sin api key)"
                                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) -e NVD_API_KEY= -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw owasp/dependency-check:latest --scan \${WORKSPACE}/vulncheckerbackend --format HTML --format JSON --out /jenkins-reports/latest/dependency-check-backend --project vulnchecker-backend --failOnCVSS ${failCvss} || true
                                                    """
                                                }
                                                dir('frontend') {
                                                    sh """
                                                        echo ">>> Dependency Check (frontend)"
                                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) -v vulnchecker-owasp-data:/usr/share/dependency-check/data:rw owasp/dependency-check:latest --scan \${WORKSPACE}/frontend --noupdate --format HTML --format JSON --out /jenkins-reports/latest/dependency-check-frontend --project vulnchecker-frontend --failOnCVSS ${failCvss} || true
                                                    """
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            post {
                                always {
                                    sh """
                                        mkdir -p \${WORKSPACE}/reports
                                        cp -r /jenkins-reports/latest/dependency-check-backend \${WORKSPACE}/reports/ 2>/dev/null || true
                                        cp -r /jenkins-reports/latest/dependency-check-frontend \${WORKSPACE}/reports/ 2>/dev/null || true
                                    """
                                    script {
                                        def hasReport = fileExists('reports/dependency-check-backend/dependency-check-report.html') || fileExists('reports/dependency-check-frontend/dependency-check-report.html')
                                        if (hasReport) {
                                            archiveArtifacts artifacts: 'reports/**/dependency-check-report.html', allowEmptyArchive: true
                                        }
                                    }
                                }
                            }
                        }

                        stage('SonarQube Analysis') {
                            when { expression { return !params.SKIP_SONAR } }
                            steps {
                                withSonarQubeEnv(params.SONAR_SERVER_NAME?.trim() ?: 'SonarQube') {
                                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                                        // 1. Escaneo del Backend
                                        dir('vulncheckerbackend') {
                                            sh """
                                                chmod +x mvnw
                                                ./mvnw sonar:sonar -q \\
                                                    -Dsonar.host.url=\${SONAR_HOST_URL:-\${SONAR_HOST}} \\
                                                    -Dsonar.token=\${SONAR_TOKEN} \\
                                                    -Dsonar.projectKey=vulnchecker-backend \\
                                                    -Dsonar.projectName=vulnchecker-backend \\
                                                    -Dsonar.java.binaries=target/classes \\
                                                    -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \\
                                                    -DskipTests
                                            """
                                        }
                                        
                                        // 2. Escaneo del Frontend
                                        dir('frontend') {
                                            sh """
                                                docker run --rm \
                                                    --network vulnchecker_devsecops \
                                                    --volumes-from vuln-jenkins \
                                                    -w "\$(pwd)" \
                                                    sonarsource/sonar-scanner-cli \
                                                    -Dsonar.host.url=\${SONAR_HOST_URL:-\${SONAR_HOST}} \
                                                    -Dsonar.token=\${SONAR_TOKEN} \
                                                    -Dsonar.projectKey=vulnchecker-frontend \
                                                    -Dsonar.projectName=vulnchecker-frontend \
                                                    -Dsonar.sources=src \
                                                    -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/*.spec.ts
                                            """
                                        }
                                    }
                                }
                                script {
                                    if (params.ENABLE_SECURITY_GATES) {
                                        // Espera evaluación de ambos análisis
                                        timeout(time: 5, unit: 'MINUTES') {
                                            def qg = waitForQualityGate()
                                            if (qg.status != 'OK') {
                                                error("[SECURITY GATE FAIL] SonarQube Quality Gate no superado: ${qg.status}")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                stage('Containerization (Docker & Trivy)') {
                    stages {
                        stage('Build Docker Images') {
                            steps {
                                sh 'docker compose -f docker-compose.yml -f docker-compose.ci.yml build backend frontend'
                            }
                        }

                        stage('Container Image Scan (Trivy)') {
                            when { expression { return !params.SKIP_TRIVY } }
                            steps {
                                script {
                                    def exitCode = (params.ENABLE_SECURITY_GATES) ? '1' : '0'

                                    sh """
                                        # Backend Scan (Consola + Guardar JSON con Timeout de 15 minutos)
                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \\
                                            -v /var/run/docker.sock:/var/run/docker.sock \\
                                            aquasec/trivy:latest image \\
                                            --timeout 15m \\
                                            --parallel 2 \\
                                            --severity HIGH,CRITICAL \\
                                            --ignore-unfixed \\
                                            --exit-code ${exitCode} \\
                                            --format table \${BACKEND_IMAGE}

                                        # Frontend Scan
                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \\
                                            -v /var/run/docker.sock:/var/run/docker.sock \\
                                            aquasec/trivy:latest image \\
                                            --timeout 15m \\
                                            --parallel 2 \\
                                            --severity HIGH,CRITICAL \\
                                            --ignore-unfixed \\
                                            --exit-code ${exitCode} \\
                                            --format table \${FRONTEND_IMAGE}
                                    """
                                }
                            }
                            post {
                                always {
                                    sh """
                                        # Generación de reportes JSON con caché de imágenes ya analizadas
                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \\
                                            -v /var/run/docker.sock:/var/run/docker.sock \\
                                            aquasec/trivy:latest image \\
                                            --timeout 15m \\
                                            --format json \\
                                            --output /jenkins-reports/latest/trivy/trivy-backend.json \${BACKEND_IMAGE} || true

                                        docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \\
                                            -v /var/run/docker.sock:/var/run/docker.sock \\
                                            aquasec/trivy:latest image \\
                                            --timeout 15m \\
                                            --format json \\
                                            --output /jenkins-reports/latest/trivy/trivy-frontend.json \${FRONTEND_IMAGE} || true

                                        cp -r /jenkins-reports/latest/trivy/*.json \${WORKSPACE}/reports/trivy/ 2>/dev/null || true
                                    """
                                    archiveArtifacts artifacts: 'reports/trivy/*.json', allowEmptyArchive: true
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when { expression { return !params.SKIP_DEPLOY } }
            steps {
                script {
                    echo ">>> Iniciando etapa de despliegue..."
                    sh """
                        cd \${WORKSPACE}

                        # Bajar todo de forma limpia
                        docker compose -f docker-compose.yml -f docker-compose.ci.yml down --remove-orphans

                        # Desplegar los servicios
                        docker compose -f docker-compose.yml -f docker-compose.ci.yml up -d --no-build
                    """
                    echo ">>> Despliegue completado con éxito. Esperando que los servicios estén arriba..."
                }
            }
        }

        stage('DAST - OWASP ZAP') {
            when { expression { return !params.SKIP_ZAP } }
            steps {
                sh '''
                    echo "Comprobando que el backend esté listo..."
                    for i in $(seq 1 24); do
                        if curl -sf http://backend:8080/actuator/health >/dev/null 2>&1 || curl -sf http://backend:8080 >/dev/null 2>&1; then
                            echo "Backend listo."
                            break
                        fi
                        echo "Esperando backend... ($i/24)"
                        sleep 5
                    done
                '''
                script {
                    timeout(time: 15, unit: 'MINUTES') {
                        sh """
                            mkdir -p /jenkins-reports/latest/zap
                            chmod -R 777 /jenkins-reports/latest/zap 2>/dev/null || true
                            docker run --rm --volumes-from vuln-jenkins --user \$(id -u):\$(id -g) \\
                                --network \${DOCKER_NETWORK} \\
                                --entrypoint bash \\
                                ghcr.io/zaproxy/zaproxy:latest \\
                                -c "rm -rf /zap/wrk && ln -s /jenkins-reports/latest/zap /zap/wrk && exec zap-baseline.py -t http://backend:8080 -r zap-report.html -J zap-report.json -I -s -m 3" || true
                            mkdir -p \${WORKSPACE}/reports/zap
                            cp /jenkins-reports/latest/zap/zap-report.html \${WORKSPACE}/reports/zap/ 2>/dev/null || true
                            cp /jenkins-reports/latest/zap/zap-report.json \${WORKSPACE}/reports/zap/ 2>/dev/null || true
                            touch \${WORKSPACE}/reports/zap/zap-report.html \${WORKSPACE}/reports/zap/zap-report.json 2>/dev/null || true
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/zap/*.html, reports/zap/*.json', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            sh """
                mkdir -p /jenkins-reports/latest
                if [ -d "\${WORKSPACE}/reports" ] && [ "\$(ls -A \${WORKSPACE}/reports 2>/dev/null)" ]; then
                    cp -rv \${WORKSPACE}/reports/* /jenkins-reports/latest/ || echo "Warning: no se pudo copiar reports"
                fi
            """
        }
        success {
            echo 'Pipeline DevSecOps con Despliegue completado. Revisa reportes.'
        }
        failure {
            echo 'Pipeline falló. Revisa los logs.'
        }
    }
}

